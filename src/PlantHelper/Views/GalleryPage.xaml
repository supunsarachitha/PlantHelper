<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlantHelper.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">
    <Grid RowDefinitions="Auto,*">
        <Border Style="{StaticResource Header}">
            <VerticalStackLayout SafeAreaEdges="Container" Spacing="2">
                <Label Style="{StaticResource HeaderTitle}" Text="Growth Gallery" />
                <Label Style="{StaticResource HeaderSubtitle}" Text="Watch them grow" />
            </VerticalStackLayout>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16" VerticalOptions="Start">
            <Label Text="Coming soon" Style="{StaticResource Subtitle}" />
        </Border>
    </Grid>
</ContentPage>
