<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlantHelper.Views.PlantDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PlantHelper.ViewModels"
    xmlns:theme="clr-namespace:PlantHelper.Theme"
    xmlns:controls="clr-namespace:PlantHelper.Controls"
    Shell.TabBarIsVisible="False"
    x:DataType="vm:PlantDetailViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">
        <ScrollView SafeAreaEdges="None" Scrolled="OnScrolled">
            <VerticalStackLayout SafeAreaEdges="None">

                <!-- ============ Hero ============ -->
                <Grid HeightRequest="320" SafeAreaEdges="None">
                    <Border Background="{Binding PlaceholderBrush}" StrokeShape="RoundRectangle 0,0,32,32" SafeAreaEdges="None">
                        <Grid>
                            <Label Style="{StaticResource Icon}" FontSize="120" TextColor="#40FFFFFF" Text="{Binding CategoryIcon}" />
                            <Image Source="{Binding Cover}" Aspect="AspectFill" IsVisible="{Binding HasCover}" />
                            <BoxView Background="{StaticResource PhotoScrim}" Color="Transparent" />
                        </Grid>
                    </Border>

                    <!-- First photo prompt -->
                    <Button Text="📷 Add photo" Style="{StaticResource SmallPillButton}" BackgroundColor="#40FFFFFF" TextColor="White"
                            HorizontalOptions="End" VerticalOptions="End" Margin="0,0,16,44"
                            Command="{Binding AddPhotoCommand}" IsVisible="{Binding HasCover, Converter={StaticResource Not}}" />

                    <!-- Title -->
                    <VerticalStackLayout VerticalOptions="End" Padding="20,0,20,40" Spacing="6">
                        <Border Style="{StaticResource Chip}" BackgroundColor="{Binding StageColor}" Padding="10,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeStageCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="5">
                                <Label Style="{StaticResource Icon}" FontSize="15" TextColor="White" Text="{Binding StageIcon}" />
                                <Label Text="{Binding StageText}" TextColor="White" FontFamily="NunitoBold" FontSize="13" />
                                <Label Style="{StaticResource Icon}" FontSize="15" TextColor="White" Text="{x:Static theme:Icons.SwapHorizontal}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label Text="{Binding Name}" Style="{StaticResource Headline}" TextColor="White" FontSize="30" LineBreakMode="TailTruncation" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding Subtitle}" TextColor="#E6FFFFFF" FontFamily="NunitoSemiBold" FontSize="14" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>

                <!-- ============ Body ============ -->
                <VerticalStackLayout Padding="16,0,16,32" Spacing="16" Margin="0,-26,0,0">

                    <!-- Stats -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding AgeValue}" Style="{StaticResource StatValue}" TextColor="#16A34A" HorizontalTextAlignment="Center" />
                                <Label Text="Days old" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding StageDaysValue}" Style="{StaticResource StatValue}" TextColor="{Binding StageColor}" HorizontalTextAlignment="Center" />
                                <Label Text="Days in stage" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding ThirdStatValue}" Style="{StaticResource StatValue}" TextColor="#F59E0B" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding ThirdStatTitle}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Quick actions -->
                    <Border Style="{StaticResource Card}" Padding="8,12" IsVisible="{Binding IsActive}">
                        <Grid ColumnDefinitions="*,*,*,*,*">
                            <Grid.Resources>
                                <Style x:Key="QuickAction" TargetType="Button">
                                    <Setter Property="FontFamily" Value="MDI" />
                                    <Setter Property="FontSize" Value="24" />
                                    <Setter Property="WidthRequest" Value="52" />
                                    <Setter Property="HeightRequest" Value="52" />
                                    <Setter Property="CornerRadius" Value="18" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalOptions" Value="Center" />
                                </Style>
                            </Grid.Resources>
                            <VerticalStackLayout Spacing="4">
                                <Button Style="{StaticResource QuickAction}" Text="{x:Static theme:Icons.Water}" Background="{StaticResource OceanGradient}" Command="{Binding LogCommand}" CommandParameter="Water" SemanticProperties.Description="Log watering" />
                                <Label Text="Water" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Button Style="{StaticResource QuickAction}" Text="{x:Static theme:Icons.Flask}" BackgroundColor="{StaticResource FeedColor}" Command="{Binding LogCommand}" CommandParameter="Feed" SemanticProperties.Description="Log feeding" />
                                <Label Text="Feed" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Button Style="{StaticResource QuickAction}" Text="{x:Static theme:Icons.Ruler}" Background="{StaticResource SunsetGradient}" Command="{Binding LogCommand}" CommandParameter="Measure" SemanticProperties.Description="Log measurement" />
                                <Label Text="Measure" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                <Button Style="{StaticResource QuickAction}" Text="{x:Static theme:Icons.Camera}" Background="{StaticResource BerryGradient}" Command="{Binding AddPhotoCommand}" SemanticProperties.Description="Add growth photo" />
                                <Label Text="Photo" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="4" Spacing="4">
                                <Button Style="{StaticResource QuickAction}" Text="{x:Static theme:Icons.Plus}" Background="{StaticResource PrimaryGradient}" Command="{Binding MoreLogCommand}" SemanticProperties.Description="More journal entry types" />
                                <Label Text="More" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Tabs -->
                    <FlexLayout JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding Tabs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectableOption">
                                <Border FlexLayout.Grow="1" Margin="3,0" StrokeShape="RoundRectangle 14" BackgroundColor="{Binding Background}" HeightRequest="48"
                                        SemanticProperties.Description="{Binding Label}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlantDetailViewModel}}, Path=SelectTabCommand, x:DataType=vm:PlantDetailViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                        <Label Style="{StaticResource Icon}" FontSize="17" Text="{Binding Icon}" TextColor="{Binding Foreground}" />
                                        <Label Text="{Binding Label}" FontFamily="NunitoBold" FontSize="11" TextColor="{Binding Foreground}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- ============ Overview tab ============ -->
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsOverviewTab}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Style="{StaticResource Card}" Padding="14" BackgroundColor="{Binding WaterStatus.Soft}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource Icon}" HorizontalOptions="Start" FontSize="26" Text="{Binding WaterStatus.Icon}" TextColor="{Binding WaterStatus.Color}" />
                                    <Label Text="{Binding WaterStatus.Title}" FontFamily="NunitoExtraBold" FontSize="15" TextColor="{Binding WaterStatus.Color}" />
                                    <Label Text="{Binding WaterStatus.Detail}" Style="{StaticResource Caption}" />
                                    <Button Text="Mark done" Style="{StaticResource SmallPillButton}" BackgroundColor="{StaticResource WaterColor}" Margin="0,6,0,0" HorizontalOptions="Start"
                                            Command="{Binding MarkDoneCommand}" CommandParameter="Water" IsVisible="{Binding CanMarkWater}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" BackgroundColor="{Binding FeedStatus.Soft}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource Icon}" HorizontalOptions="Start" FontSize="26" Text="{Binding FeedStatus.Icon}" TextColor="{Binding FeedStatus.Color}" />
                                    <Label Text="{Binding FeedStatus.Title}" FontFamily="NunitoExtraBold" FontSize="15" TextColor="{Binding FeedStatus.Color}" />
                                    <Label Text="{Binding FeedStatus.Detail}" Style="{StaticResource Caption}" />
                                    <Button Text="Mark done" Style="{StaticResource SmallPillButton}" BackgroundColor="{StaticResource FeedColor}" Margin="0,6,0,0" HorizontalOptions="Start"
                                            Command="{Binding MarkDoneCommand}" CommandParameter="Feed" IsVisible="{Binding CanMarkFeed}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasReadings}">
                            <VerticalStackLayout Spacing="10">
                                <Label Style="{StaticResource SectionTitle}" Text="Latest readings" />
                                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Readings}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InfoRow">
                                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="{Binding Color, Converter={StaticResource SoftColor}}" Padding="12,8" Margin="0,0,8,8" MinimumWidthRequest="92">
                                                <VerticalStackLayout Spacing="0">
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Style="{StaticResource Icon}" FontSize="14" Text="{Binding Icon}" TextColor="{Binding Color}" />
                                                        <Label Text="{Binding Label}" Style="{StaticResource Caption}" TextColor="{Binding Color}" />
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding Value}" FontFamily="NunitoExtraBold" FontSize="17" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="4">
                                <Label Style="{StaticResource SectionTitle}" Text="Plant details" Margin="0,0,0,6" />
                                <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding InfoRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InfoRow">
                                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" Padding="0,6">
                                                <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding Color, Converter={StaticResource SoftColor}}">
                                                    <Label Style="{StaticResource Icon}" FontSize="18" Text="{Binding Icon}" TextColor="{Binding Color}" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding Value}" FontFamily="NunitoBold" VerticalOptions="Center" HorizontalTextAlignment="End" MaximumWidthRequest="210" LineBreakMode="TailTruncation" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotes}">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource SectionTitle}" Text="Notes" />
                                <Label Text="{Binding Notes}" Style="{StaticResource Body}" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Style="{StaticResource SecondaryButton}" Text="Change status" Command="{Binding ChangeStatusCommand}" />
                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Text="Delete plant" Command="{Binding DeleteCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ============ Journal tab ============ -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsJournalTab}">
                        <Button Style="{StaticResource SecondaryButton}" Text="+ Add journal entry" Command="{Binding MoreLogCommand}" />
                        <VerticalStackLayout Spacing="8" Padding="0,20" IsVisible="{Binding HasJournal, Converter={StaticResource Not}}">
                            <Label Style="{StaticResource Icon}" FontSize="48" Text="{x:Static theme:Icons.NoteText}" TextColor="#8B5CF6" />
                            <Label Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" Text="No entries yet" />
                            <Label Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Text="Log waterings, feedings, measurements and more to build this plant's story." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Journal}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogItemViewModel">
                                    <Border Style="{StaticResource Card}" Padding="12" SemanticProperties.Description="{Binding Title}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlantDetailViewModel}}, Path=OpenLogCommand, x:DataType=vm:PlantDetailViewModel}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="46,*" ColumnSpacing="12">
                                            <Border WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 14" BackgroundColor="{Binding Soft}" VerticalOptions="Start">
                                                <Label Style="{StaticResource Icon}" Text="{Binding Icon}" TextColor="{Binding Color}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding Title}" FontFamily="NunitoBold" FontSize="15" TextColor="{Binding Color}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource Caption}" />
                                                </Grid>
                                                <Label Text="{Binding Details}" Style="{StaticResource Body}" IsVisible="{Binding HasDetails}" />
                                                <Label Text="{Binding Notes}" Style="{StaticResource Muted}" FontAttributes="Italic" IsVisible="{Binding HasNotes}" MaxLines="3" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ============ Photos tab ============ -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsPhotosTab}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Style="{StaticResource PrimaryButton}" Background="{StaticResource BerryGradient}" Text="📷 Add photo" Command="{Binding AddPhotoCommand}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="Before &amp; after" Command="{Binding CompareCommand}" IsEnabled="{Binding HasPhotos}" />
                        </Grid>
                        <VerticalStackLayout Spacing="8" Padding="0,20" IsVisible="{Binding HasPhotos, Converter={StaticResource Not}}">
                            <Label Style="{StaticResource Icon}" FontSize="48" Text="{x:Static theme:Icons.Camera}" TextColor="#EC4899" />
                            <Label Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" Text="No photos yet" />
                            <Label Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Text="A weekly photo with the height noted builds a beautiful growth timeline." />
                        </VerticalStackLayout>
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Photos}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PhotoItemViewModel">
                                    <Border StrokeShape="RoundRectangle 16" Margin="0,0,8,8" BackgroundColor="#1F2937"
                                            WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type vm:PlantDetailViewModel}}, Path=PhotoTileSize, x:DataType=vm:PlantDetailViewModel}"
                                            HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type vm:PlantDetailViewModel}}, Path=PhotoTileSize, x:DataType=vm:PlantDetailViewModel}"
                                            SemanticProperties.Description="{Binding Summary}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlantDetailViewModel}}, Path=OpenPhotoCommand, x:DataType=vm:PlantDetailViewModel}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <Image Source="{Binding Source}" Aspect="AspectFill" />
                                            <Border Style="{StaticResource Chip}" BackgroundColor="#99000000" Padding="6,2" Margin="6" VerticalOptions="End">
                                                <Label Text="{Binding DayText}" TextColor="White" FontFamily="NunitoBold" FontSize="11" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- ============ Growth tab ============ -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsGrowthTab}">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Style="{StaticResource Card}" Padding="14" Background="{StaticResource SunsetGradient}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding LatestHeightText}" TextColor="White" FontFamily="NunitoExtraBold" FontSize="22" />
                                    <Label Text="Current height" TextColor="#FFF7ED" FontSize="12" FontFamily="NunitoSemiBold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Background="{StaticResource HeaderGradient}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding TotalGrowthText}" TextColor="White" FontFamily="NunitoExtraBold" FontSize="22" />
                                    <Label Text="Total growth" TextColor="#ECFDF5" FontSize="12" FontFamily="NunitoSemiBold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Background="{StaticResource OceanGradient}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding AverageRateText}" TextColor="White" FontFamily="NunitoExtraBold" FontSize="17" />
                                    <Label Text="Average rate" TextColor="#EFF6FF" FontSize="12" FontFamily="NunitoSemiBold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14" Background="{StaticResource BerryGradient}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding RecentRateText}" TextColor="White" FontFamily="NunitoExtraBold" FontSize="17" />
                                    <Label Text="Last 7 days" TextColor="#FDF2F8" FontSize="12" FontFamily="NunitoSemiBold" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Button Style="{StaticResource SecondaryButton}" Text="+ Log a measurement" Command="{Binding LogCommand}" CommandParameter="Measure" />

                        <VerticalStackLayout Spacing="8" Padding="0,16" IsVisible="{Binding HasCharts, Converter={StaticResource Not}}">
                            <Label Style="{StaticResource Icon}" FontSize="48" Text="{x:Static theme:Icons.ChartLine}" TextColor="#F97316" />
                            <Label Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" Text="Charts need a little data" />
                            <Label Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Text="Log heights (or add heights to photos), pH, EC and climate readings on two or more days to see trends." />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Charts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChartCard">
                                    <Border Style="{StaticResource Card}" Padding="14,14,10,8">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding Soft}">
                                                    <Label Style="{StaticResource Icon}" FontSize="19" Text="{Binding Icon}" TextColor="{Binding Color}" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" Style="{StaticResource Subtitle}" />
                                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <controls:ChartView Series="{Binding Series}"
                                                                LabelColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                                                GridColor="{AppThemeBinding Light=#14000000, Dark=#22FFFFFF}"
                                                                SemanticProperties.Description="{Binding Title, StringFormat='{0} chart'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <!-- Floating top bar (outside the ScrollView so it respects the status bar inset).
             Its gradient background fades in once the hero scrolls away. -->
        <Border x:Name="TopBarBackground" Background="{StaticResource HeaderGradient}" Opacity="0" VerticalOptions="Start" SafeAreaEdges="None" InputTransparent="True"
                HeightRequest="{Binding Source={x:Reference TopBar}, Path=Height, x:DataType=Grid}" />
        <Grid x:Name="TopBar" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="12,8" VerticalOptions="Start" SafeAreaEdges="Container">
            <Button Style="{StaticResource OverlayIconButton}" Text="{x:Static theme:Icons.ArrowLeft}" Command="{Binding BackCommand}" SemanticProperties.Description="Back" />
            <Label x:Name="TopBarTitle" Grid.Column="1" Text="{Binding Name}" Opacity="0" TextColor="White" FontFamily="NunitoExtraBold" FontSize="19"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" Margin="6,0" />
            <Button Grid.Column="2" Style="{StaticResource OverlayIconButton}" Text="{x:Static theme:Icons.Heart}" TextColor="{Binding FavoriteColor}" Command="{Binding ToggleFavoriteCommand}" SemanticProperties.Description="Toggle favourite" />
            <Button Grid.Column="3" Style="{StaticResource OverlayIconButton}" Text="{x:Static theme:Icons.Pencil}" Command="{Binding EditCommand}" SemanticProperties.Description="Edit plant" />
            <Button Grid.Column="4" Style="{StaticResource OverlayIconButton}" Text="{x:Static theme:Icons.DotsVertical}" Command="{Binding ChangeStatusCommand}" SemanticProperties.Description="Plant status options" />
        </Grid>
    </Grid>
</ContentPage>
