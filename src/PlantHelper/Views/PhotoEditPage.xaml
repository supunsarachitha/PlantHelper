<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlantHelper.Views.PhotoEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PlantHelper.ViewModels"
    xmlns:controls="clr-namespace:PlantHelper.Controls"
    Shell.TabBarIsVisible="False"
    x:DataType="vm:PhotoEditViewModel"
    Title="{Binding Title}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">
                <Border StrokeShape="RoundRectangle 24" HeightRequest="340" BackgroundColor="#111">
                    <Image Source="{Binding Image}" Aspect="AspectFill" />
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding PlantName}" Style="{StaticResource SectionTitle}" />
                        <controls:FormEntry Label="Caption" Text="{Binding Caption}" Keyboard="Text" MaxLength="120" Placeholder="e.g. First flowers!" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <controls:FormEntry Label="Plant height" Unit="{Binding LengthUnit}" Text="{Binding Height}" Placeholder="{Binding HeightHint}" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Style="{StaticResource FieldLabel}" Text="Date" />
                                <Border Style="{StaticResource FormField}">
                                    <DatePicker Date="{Binding Date}" Format="d MMM yyyy" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Style="{StaticResource Caption}" Text="Adding the height with each photo builds your growth-rate chart automatically." />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Use as cover photo" FontFamily="NunitoSemiBold" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsCover}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource DangerButton}" Text="Delete photo" Command="{Binding DeleteCommand}" />
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="1" Padding="16,10,16,12" BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Style="{StaticResource SecondaryButton}" Text="Skip" Command="{Binding SkipCommand}" IsVisible="{Binding IsNew}" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Text="Save details" Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
