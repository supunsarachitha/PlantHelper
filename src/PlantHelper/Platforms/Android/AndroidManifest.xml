<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- No cloud backup (data stays local). Android 12+ still allows local device-to-device transfer, see data_extraction_rules. -->
	<application
		android:allowBackup="false"
		android:fullBackupContent="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:icon="@mipmap/appicon"
		android:roundIcon="@mipmap/appicon_round"
		android:supportsRtl="true"
		android:label="PlantHelper"></application>

	<!-- Daily care reminder notification (Android 13+ runtime permission) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Restore the daily reminder after the phone restarts -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
