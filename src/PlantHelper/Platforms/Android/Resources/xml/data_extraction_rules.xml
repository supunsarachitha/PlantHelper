<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never upload app data to cloud backup (data stays on the device).
     Local device-to-device transfer (new phone setup via cable / Wi-Fi) is still allowed.
     Users can also move data with the in-app Export / Import backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
