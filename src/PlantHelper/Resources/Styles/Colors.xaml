<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#0E9F6E</Color>
    <Color x:Key="PrimaryDark">#046C4E</Color>
    <Color x:Key="PrimaryLight">#34D399</Color>
    <Color x:Key="PrimarySoft">#DEF7EC</Color>
    <Color x:Key="PrimarySoftDark">#12382A</Color>
    <Color x:Key="Secondary">#0891B2</Color>
    <Color x:Key="Accent">#FACC15</Color>
    <Color x:Key="Coral">#FB7185</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- Surfaces -->
    <Color x:Key="PageBgLight">#F2F7F4</Color>
    <Color x:Key="PageBgDark">#0A130E</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#142019</Color>
    <Color x:Key="CardAltLight">#EAF3EE</Color>
    <Color x:Key="CardAltDark">#1B2C22</Color>
    <Color x:Key="BorderLight">#DCE8E0</Color>
    <Color x:Key="BorderDark">#2A3E32</Color>

    <!-- Text -->
    <Color x:Key="TextLight">#13241A</Color>
    <Color x:Key="TextDark">#EAF4EE</Color>
    <Color x:Key="TextMutedLight">#5B6F63</Color>
    <Color x:Key="TextMutedDark">#9BB2A5</Color>

    <!-- Care log colours -->
    <Color x:Key="WaterColor">#3B82F6</Color>
    <Color x:Key="FeedColor">#8B5CF6</Color>
    <Color x:Key="MeasureColor">#F97316</Color>
    <Color x:Key="EnvironmentColor">#06B6D4</Color>
    <Color x:Key="PestColor">#EF4444</Color>
    <Color x:Key="TrainingColor">#EAB308</Color>
    <Color x:Key="TransplantColor">#B45309</Color>
    <Color x:Key="HarvestColor">#F59E0B</Color>
    <Color x:Key="NoteColor">#64748B</Color>
    <Color x:Key="PhotoColor">#EC4899</Color>

    <!-- Gray scale kept from template (used by default control styles) -->
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#047857" />
        <GradientStop Offset="0.55" Color="#0E9F6E" />
        <GradientStop Offset="1" Color="#65C466" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0E9F6E" />
        <GradientStop Offset="1" Color="#22C55E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SunsetGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F97316" />
        <GradientStop Offset="1" Color="#FACC15" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OceanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2563EB" />
        <GradientStop Offset="1" Color="#06B6D4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BerryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7C3AED" />
        <GradientStop Offset="1" Color="#EC4899" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PhotoScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.35" Color="#00000000" />
        <GradientStop Offset="1" Color="#CC000000" />
    </LinearGradientBrush>

</ResourceDictionary>
